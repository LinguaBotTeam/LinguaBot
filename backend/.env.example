# Скопируйте файл в .env и при необходимости измените значения.

# База данных. По умолчанию используется SQLite рядом с рабочим каталогом.
DATABASE_URL=sqlite+aiosqlite:///./linguabot.db
# Пример для PostgreSQL (требуется установить asyncpg):
# DATABASE_URL=postgresql+asyncpg://linguabot:linguabot@localhost:5432/linguabot

# Секрет для подписи JWT. Обязательно замените в продакшене.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Источники для CORS. Значение по умолчанию "*" подходит для локальной разработки.
CORS_ORIGINS=["*"]

# Локальная Ollama: только HTTP на loopback, без облачных моделей.
# В процессе Ollama отдельно отключите облачные функции: OLLAMA_NO_CLOUD=1.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TIMEOUT_SECONDS=120
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=384

# Скопируйте файл в .env и при необходимости измените значения.

# База данных. По умолчанию используется SQLite рядом с рабочим каталогом.
DATABASE_URL=sqlite+aiosqlite:///./linguabot.db
# Пример для PostgreSQL (требуется установить asyncpg):
# DATABASE_URL=postgresql+asyncpg://linguabot:linguabot@localhost:5432/linguabot

# Секрет для подписи JWT. Обязательно замените в продакшене.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Источники для CORS. Значение по умолчанию "*" подходит для локальной разработки.
CORS_ORIGINS=["*"]

# Провайдер диалогов: ollama (по умолчанию) или cloudflare.
# Автоматического переключения между провайдерами нет.
LLM_PROVIDER=ollama

# Локальная Ollama: только HTTP на loopback, без облачных моделей.
# В процессе Ollama отдельно отключите облачные функции: OLLAMA_NO_CLOUD=1.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
LLM_TIMEOUT_SECONDS=120
LLM_CONTEXT_TOKENS=4096
LLM_MAX_OUTPUT_TOKENS=384

# Cloudflare Workers AI: включайте только после проверки Workers Free
# в нужном аккаунте. Сам код не проверяет тариф: Workers Paid может
# начислять оплату сверх бесплатной квоты. Не подключайте платный тариф,
# AI Gateway или предоплаченные кредиты для этой конфигурации.
# Затем заполните поля ниже в личном .env и задайте LLM_PROVIDER=cloudflare.
# ACCOUNT_ID: 32 шестнадцатеричных символа; API_TOKEN: Workers AI Read + Edit.
# Не передавайте токен в браузер и не добавляйте .env в Git.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
CLOUDFLARE_TIMEOUT_SECONDS=60
CLOUDFLARE_MAX_OUTPUT_TOKENS=512
